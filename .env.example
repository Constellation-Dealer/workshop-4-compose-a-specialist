# ═══════════════════════════════════════════════════════════════
#  CONFIGURATION — Copy this file to .env and fill in the values.
#  Get these from the Champion Program Portal → Workshop Details.
#  Never commit the .env you create; .gitignore already excludes it.
# ═══════════════════════════════════════════════════════════════

# ── API Base URLs ──────────────────────────────────────────────
# IDMS base URL (mints the bearer token)
IDMS_URL=
# TargetMCP Gateway base URL (the system under test)
GATEWAY_URL=

# ── Tenant Context ─────────────────────────────────────────────
# DEALER_GUID is your TENANT id. "Dealer" is this platform's word for a
# tenant, and it is spelled that way here because the API path uses it
# verbatim: /api/v1/{dealerGuid}/...
# It is one shared DEV test tenant for the whole cohort — not a real
# dealership, and nothing in it is production data.
DEALER_GUID=

# ── The console (optional) ─────────────────────────────────────
# Where the second half of this workshop happens. Leave it blank unless you were
# told otherwise; the page already defaults to the DEV console.
CONSOLE_URL=

# ── Credentials ────────────────────────────────────────────────
USERNAME=
PASSWORD=
CLIENT_SECRET=
